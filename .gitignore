# OS / Python
.DS_Store
__pycache__/
*.py[cod]

# Raw experiment runs are local by default.
# They may contain Copilot telemetry metadata (including pseudonymous identifiers)
# and large prompt/response artifacts. Commit only sanitized aggregate results.
experiments/**/runs/**

# Local experiment scratch / preflight artifacts
experiments/**/.local/**

# Generic telemetry/log outputs if created outside ignored run directories
*.otel.jsonl
otel.jsonl

# Local dogfood evidence store. Raw personal evidence is never committed by default.
.wiki-lab/

# Generated VS Code dogfood packaging outputs; the Python core source of truth stays under dogfood/llm_wiki.
dogfood/vscode/python/
dogfood/vscode/dist/
